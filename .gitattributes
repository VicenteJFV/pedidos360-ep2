# Normaliza los saltos de linea dentro del repositorio.
* text=auto

# CRITICO: el user-data de EC2 corre en Amazon Linux. Si git lo entrega con
# CRLF, bash falla con "\r: command not found" y la instancia queda sin Java.
*.sh text eol=lf

# Los scripts de PowerShell se quedan con finales de Windows.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Archivos que no deben tocarse nunca.
*.jar binary
*.pem binary
*.p12 binary
*.jks binary
*.sso binary

# Lo que se ejecuta o se lee dentro de los contenedores en la EC2 (Linux). Un
# Dockerfile con CRLF pasa "\r" al final de cada RUN, y un .conf con CRLF puede
# dejar un "\r" pegado a la contrasena.
Dockerfile text eol=lf
*.yml text eol=lf
*.conf text eol=lf
